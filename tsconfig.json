{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "strict": true,
    "sourceMap": true,
    "rootDir": "src",
    "outDir": "public/dist",
    "jsx": "react-jsx",
    "jsxImportSource": "@loafsx",
    "paths": {
      "@loafsx/jsx-runtime": [
        "./src/util/jsx-runtime.ts"
      ],
      "@loafsx/jsx-dev-runtime": [
        "./src/util/jsx-runtime.ts"
      ]
    }
  },
  "include": [
    "src/**/*"
  ]
}
